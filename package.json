{
  "name": "pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "deps:install": "pnpm install --frozen-lockfile --store-dir .pnpm-store",
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "typecheck": "pnpm run check",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:editor-browser": "node --test tests/editor.browser.ts",
    "foundation-build": "pnpm run check && pnpm run build",
    "foundation-security": "pnpm run test",
    "start": "node --env-file-if-exists=.env.local server/start.ts",
    "test:policy": "python3 scripts/check_repository.py",
    "verify": "pnpm check && pnpm test && pnpm test:policy && pnpm build",
    "test:production": "node scripts/verify-template.mjs",
    "test:template": "node scripts/verify-template.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-template.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local .neander/migrate.mjs"
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@blocknote/shadcn": "0.57.0",
    "@electric-sql/pglite": "0.5.17",
    "@fontsource/inter": "5.3.0",
    "better-auth": "1.7.27",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.23.0",
    "pg": "8.23.1",
    "radix-ui": "1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.6",
    "playwright": "1.65.1"
  }
}
